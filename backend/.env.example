# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5432/epaper_db?schema=public"

# Redis 配置
REDIS_URL="redis://localhost:6379"

# JWT 配置
JWT_SECRET="your-super-secret-key-change-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# 服务器配置
PORT=3001
NODE_ENV=development

# 文件上传配置
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
